+    let result = DownloadEngine::new()
+        .unwrap()
+        .download(&format!("http://{address}/0"), &target)
+        .await;
+    server.abort();
+    result.expect("a chain of exactly ten redirects is within the cap");
+    assert_eq!(fs::read(&target).unwrap(), b"done");
+}
